{
  "name": "pms-backend",
  "version": "1.0.0",
  "description": "Smart Patient Monitoring System — Backend API",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js --sync",
    "dev": "nodemon server.js",
    "worker": "node workers/ingest.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "node src/seeders/seed.js",
    "db:sync": "node src/scripts/syncDb.js",
    "simulator": "node simulator/deviceSimulator.js",
    "test:llm": "node scripts/testLlmSummary.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.7.0",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "socket.io": "^4.7.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2"
  }
}

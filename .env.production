# ═══════════════════════════════════════════════════════
# Backend — Production Environment (cPanel Deployment)
# ═══════════════════════════════════════════════════════
# Copy this file to .env on your cPanel server and fill in real values.

# ── Database (cPanel PostgreSQL) ──────────────────────
# Create a PostgreSQL database in cPanel → PostgreSQL Databases
# Format: postgres://username:password@localhost:5432/dbname
DATABASE_URL=postgres://cpanel_user:cpanel_pass@localhost:5432/pms_production

# ── JWT Authentication ────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=24h

# ── Redis (cPanel or external) ────────────────────────
# If cPanel has Redis: redis://localhost:6379
# If using external Redis (e.g. Upstash): redis://your-redis-url
REDIS_URL=redis://localhost:6379

# ── MQTT Broker ───────────────────────────────────────
# For production, use an external MQTT broker (e.g. HiveMQ Cloud, EMQX)
# Format: mqtt://host:port or mqtts://host:port (TLS)
MQTT_BROKER_URL=mqtt://localhost:1883

# ── AI / LLM (Alibaba Cloud DashScope) ────────────────
# Get key from: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ── CORS — allowed frontend origins ───────────────────
# Comma-separated list. Use your actual domain(s).
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Server ────────────────────────────────────────────
PORT=4000
NODE_ENV=production
